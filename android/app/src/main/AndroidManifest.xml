<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Benachrichtigungen: ab Android 13 muss die Person zustimmen. Ohne
         Zustimmung bleibt die Abrufliste in der App der Weg — es geht dann
         nichts verloren, es dauert nur bis zum nächsten Öffnen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Standort nur im Vordergrund: für Kartenausschnitt und Entfernungen.
         Er bleibt auf dem Gerät und wird nie ans Backend geschickt. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".DorfApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DorfApp"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          AppAuth bringt die RedirectUriReceiverActivity (inkl. Intent-Filter für
          ${appAuthRedirectScheme}) selbst mit, aber ohne eigenes Theme. Da sie eine
          AppCompatActivity ist, muss ihr hier ein AppCompat-Theme zugewiesen werden —
          sonst crasht die App beim Rücksprung aus dem Browser. Intent-Filter und
          android:exported kommen per Manifest-Merge aus der Library.
        -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:theme="@style/Theme.DorfApp.AuthRedirect" />

        <!-- Push-Benachrichtigungen der Vergabe (Firebase Cloud Messaging). -->
        <service
            android:name=".push.DorfMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Gilt für Nachrichten, die Android im Hintergrund selbst anzeigt. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_dorf" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="hinweise" />

        <!--
            Firebase bleibt still, bis jemand Mitteilungen erlaubt.

            Ohne diese beiden Schalter meldet sich das Firebase-SDK beim
            ersten Start von selbst bei Google an: Es legt eine
            Installations-Kennung an und holt sich eine FCM-Kennung, ganz ohne
            Zutun der App. Damit entstünde das Datum schon vor jeder
            Einwilligung — auch bei jemandem, der Mitteilungen abgelehnt hat.

            Scharf gestellt wird ausdrücklich in Geraeteabgleich.anmelden(),
            also erst bei erteilter Erlaubnis; beim Entzug und beim Abmelden
            geht es wieder aus. Die Einstellung ist bleibend (Firebase merkt
            sie sich selbst), diese Werte gelten also nur beim allerersten
            Start.
        -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_data_collection_default_enabled"
            android:value="false" />
    </application>
</manifest>
