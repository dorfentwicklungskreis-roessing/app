// Dev-Container für das Monorepo: Android (Kotlin/Compose) + Go-Backend.
//
// Enthalten: JDK 21 + Android-SDK 35 (Dockerfile), Go, Node und die Claude-CLI
// als Features. Damit laufen:
//   cd backend  && go vet ./... && go test ./...
//   cd android  && ./gradlew testDebugUnitTest assembleDebug
//
// Emulator: das SDK-Paket "emulator" ist installiert, das System-Image nicht
// (spart ~3,5 GB Image-Größe). Einmalig im Container:
//   sdkmanager "system-images;android-35;google_apis;x86_64"
//   avdmanager create avd -n dorf35 -k "system-images;android-35;google_apis;x86_64" -d pixel_6
//   emulator -avd dorf35 -no-window -no-audio -gpu swiftshader_indirect &
// Der Emulator braucht /dev/kvm im Container. Das Gerät wird NICHT hier per
// runArgs gesetzt — hatchery reicht /dev/kvm automatisch in jede Drone durch.
// Wer den Container ohne hatchery startet, ergänzt beim Start selbst
// "--device=/dev/kvm". Die Zugriffsrechte auf dem Node richtet
// postStartCommand ein (die kvm-GID des Hosts existiert im Container nicht).
{
  "name": "Dorf-App (Android + Go)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/go:1@sha256:3b2c7acfdb24de88292283d10eb7517ccc45f60ae22a97030f1cf4fbd03634f3": {
      "version": "1.23"
    },
    "ghcr.io/devcontainers/features/node:1@sha256:8c0de46939b61958041700ee89e3493f3b2e4131a06dc46b4d9423427d06e5f6": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0@sha256:cfc2e7d3e9fd3b9b01f8d5cb158508a884c8c0ede2e23ed10f32dea5d4ffe69a": {}
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=dorf-app-gradle-cache,target=/home/vscode/.gradle,type=volume"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.gradle",
  "postStartCommand": "sudo sh -c 'test -e /dev/kvm && chmod 0666 /dev/kvm; exit 0'",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "fwcd.kotlin",
        "mathiasfrohlich.kotlin",
        "golang.go",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-german"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": false,
        "cSpell.language": "de-DE",
        "cSpell.words": [
          "Beete",
          "Blumenkasten",
          "Hitzefaktor",
          "Nordstemmen",
          "Rössing",
          "Zitadel"
        ]
      }
    }
  }
}
